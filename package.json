{
  "name": "paso",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm --filter @paso/server dev\" \"pnpm --filter @paso/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.14.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
