{
  "name": "paso",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "dev": "pnpm --filter @paso/shared build && node scripts/dev.mjs",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter \"@paso/server...\" build && pnpm -r typecheck",
    "test": "pnpm --filter \"@paso/mcp...\" build && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.14.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
